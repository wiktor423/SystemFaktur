# Skopiuj do `.env` i uzupełnij. Sekrety nigdy nie trafiają do repozytorium.

# --- Baza danych ------------------------------------------------------------
DATABASE_URL="postgresql://lexalpha:lexalpha@localhost:5432/lexalpha?schema=public&connection_limit=5"

# --- KSeF -------------------------------------------------------------------
# Wyłącznie środowisko testowe. Token uzyskujesz jednorazowym uwierzytelnieniem
# XAdES samopodpisanym certyfikatem — instrukcja w README.
KSEF_ENV=test
KSEF_BASE_URL=https://api-test.ksef.mf.gov.pl/api/v2
KSEF_NIP=
KSEF_TOKEN=

# Adapter integracji: "mock" (dane demonstracyjne) albo "http" (prawdziwy KSeF).
KSEF_CLIENT=mock

# --- Harmonogram ------------------------------------------------------------
# Sekret chroniący `/api/ksef/scheduled-run`. Bez niego endpoint jest wyłączony.
# Wygenerujesz go np. przez `openssl rand -base64 24`.
SCHEDULER_TOKEN=

# Strefa czasowa godzin harmonogramu (domyślnie Europe/Warsaw).
SCHEDULER_TIMEZONE=Europe/Warsaw

# `off` wyłącza wbudowany wyzwalacz — użyj, gdy przebiegi odpala cron platformy.
KSEF_SCHEDULER=
